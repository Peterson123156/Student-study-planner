<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Settings | StudyFlow</title>

    <!-- Main CSS -->
    <link rel="stylesheet" href="css/style.css">

</head>


<body>


    <!-- =========================
         NAVIGATION BAR
    ========================== -->

    <header>

        <nav>

            <!-- WEBSITE LOGO -->

            <a href="index.html" class="logo">
                Study<span>Flow</span>
            </a>


            <!-- NAVIGATION LINKS -->

            <ul class="nav-links">

                <li>
                    <a href="index.html">
                        Home
                    </a>
                </li>

                <li>
                    <a href="subjects.html">
                        Subjects
                    </a>
                </li>

                <li>
                    <a href="schedule.html">
                        Schedule
                    </a>
                </li>

                <li>
                    <a href="assignments.html">
                        Assignments
                    </a>
                </li>

                <li>
                    <a href="goals.html">
                        Goals
                    </a>
                </li>

                <li>
                    <a href="progress.html">
                        Progress
                    </a>
                </li>

            </ul>


            <a href="settings.html" class="nav-button">
                Settings
            </a>

        </nav>

    </header>



    <!-- =========================
         MAIN CONTENT
    ========================== -->

    <main class="page-container">


        <!-- PAGE HEADER -->

        <section class="page-header">

            <h1>
                ⚙️ Settings
            </h1>

            <p>
                Customize your StudyFlow experience and manage your saved data.
            </p>

        </section>



        <!-- =========================
             APPEARANCE SETTINGS
        ========================== -->

        <section class="settings-card">

            <h2>
                🎨 Appearance
            </h2>

            <p>
                Choose how you would like StudyFlow to look.
            </p>


            <div class="setting-row">

                <div>

                    <h3>
                        Dark Mode
                    </h3>

                    <p>
                        Switch between light and dark mode.
                    </p>

                </div>


                <button
                    id="themeToggle"
                    class="theme-btn"
                    type="button"
                >

                    🌙 Dark Mode

                </button>

            </div>

        </section>



        <!-- =========================
             STUDY INFORMATION
        ========================== -->

        <section class="settings-card">

            <h2>
                📚 Study Information
            </h2>

            <p>
                Your StudyFlow information is saved in your browser using local storage.
            </p>


            <div class="setting-row">

                <div>

                    <h3>
                        Manage Your Subjects
                    </h3>

                    <p>
                        Add or remove subjects from your study planner.
                    </p>

                </div>


                <a
                    href="subjects.html"
                    class="secondary-button"
                >

                    Subjects

                </a>

            </div>



            <div class="setting-row">

                <div>

                    <h3>
                        Manage Your Schedule
                    </h3>

                    <p>
                        Create and organize your study sessions.
                    </p>

                </div>


                <a
                    href="schedule.html"
                    class="secondary-button"
                >

                    Schedule

                </a>

            </div>



            <div class="setting-row">

                <div>

                    <h3>
                        Manage Assignments
                    </h3>

                    <p>
                        View assignments and update their completion status.
                    </p>

                </div>


                <a
                    href="assignments.html"
                    class="secondary-button"
                >

                    Assignments

                </a>

            </div>



            <div class="setting-row">

                <div>

                    <h3>
                        Manage Goals
                    </h3>

                    <p>
                        Update your academic goals and progress.
                    </p>

                </div>


                <a
                    href="goals.html"
                    class="secondary-button"
                >

                    Goals

                </a>

            </div>

        </section>



        <!-- =========================
             DATA MANAGEMENT
        ========================== -->

        <section class="settings-card">

            <h2>
                🗂️ Data Management
            </h2>

            <p>
                Manage the information saved in your StudyFlow planner.
            </p>


            <div class="setting-row">

                <div>

                    <h3>
                        Reset StudyFlow Data
                    </h3>

                    <p>
                        This will remove all saved subjects, schedules,
                        assignments, goals, and progress from this browser.
                    </p>

                </div>


                <button
                    id="resetData"
                    class="reset-btn"
                    type="button"
                >

                    Reset Data

                </button>

            </div>

        </section>



        <!-- =========================
             ABOUT SECTION
        ========================== -->

        <section class="settings-card">

            <h2>
                ℹ️ About StudyFlow
            </h2>

            <p>
                StudyFlow is a student study planner designed to help
                students organize subjects, manage assignments, plan
                study sessions, set goals, and monitor progress.
            </p>


            <div class="setting-row">

                <div>

                    <h3>
                        Version
                    </h3>

                    <p>
                        StudyFlow v1.0
                    </p>

                </div>

            </div>


            <div class="setting-row">

                <div>

                    <h3>
                        Your Progress
                    </h3>

                    <p>
                        View your current study statistics and assignment progress.
                    </p>

                </div>


                <a
                    href="progress.html"
                    class="primary-button"
                >

                    View Progress →

                </a>

            </div>

        </section>


    </main>



    <!-- =========================
         FOOTER
    ========================== -->

    <footer>

        <div class="footer-container">


            <!-- FOOTER BRAND -->

            <div class="footer-brand">

                <h3>
                    Study<span>Flow</span>
                </h3>

                <p>
                    Organize your studies, stay productive,
                    and make progress toward your goals.
                </p>

            </div>



            <!-- FOOTER LINKS -->

            <div class="footer-links">

                <h4>
                    Quick Links
                </h4>


                <a href="index.html">
                    Home
                </a>


                <a href="subjects.html">
                    Subjects
                </a>


                <a href="schedule.html">
                    Study Schedule
                </a>


                <a href="assignments.html">
                    Assignments
                </a>


                <a href="goals.html">
                    Goals
                </a>


                <a href="progress.html">
                    Progress
                </a>

            </div>


        </div>



        <div class="copyright">

            © 2026 StudyFlow. Student Study Planner.

        </div>

    </footer>



    <!-- =========================
         JAVASCRIPT
    ========================== -->

    <script src="js/app.js"></script>


</body>

</html>